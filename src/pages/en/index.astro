---
// src/pages/en/index.astro — English version (served under /en/)
import { getRelativeLocaleUrl } from "astro:i18n";
import Portfolio from "../../components/Portfolio.astro";
import {
  profile,
  intro,
  skillGroups,
  experience,
  projects,
  contactHeadline,
  footerNote,
  ui,
} from "../../data/content.en.ts";

const altHref = getRelativeLocaleUrl("es", "/");
---
<Portfolio
  lang="en"
  altHref={altHref}
  profile={profile}
  intro={intro}
  skillGroups={skillGroups}
  experience={experience}
  projects={projects}
  contactHeadline={contactHeadline}
  footerNote={footerNote}
  ui={ui}
/>
